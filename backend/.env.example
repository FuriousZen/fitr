# fitr backend configuration.
#
# Copy to backend/.env and fill in. `.env` is gitignored. Never commit real keys.
# Every value here is read from the process environment; nothing is hardcoded in
# source. See app/config.py for the authoritative list and defaults.

# ---------------------------------------------------------------- database ---
# SQLAlchemy URL. Must use the psycopg3 dialect (`postgresql+psycopg://`),
# not bare `postgresql://` (which selects psycopg2).
FITR_DATABASE_URL=postgresql+psycopg://fitr:fitr@127.0.0.1:5432/fitr
FITR_TEST_DATABASE_URL=postgresql+psycopg://fitr:fitr@127.0.0.1:5432/fitr_test

# ------------------------------------------------------------------- CLIP ----
# HuggingFace model id. Changing this changes the embedding dimension, which
# must match FITR_EMBED_DIM or startup fails loudly.
FITR_CLIP_MODEL=openai/clip-vit-base-patch32
FITR_EMBED_DIM=512
FITR_CLIP_DEVICE=cpu
# Torch intra-op threads. 0 = leave torch's default alone.
FITR_TORCH_THREADS=0
# Load the CLIP weights at process start instead of on first use.
FITR_CLIP_EAGER=0
# Never contact the HuggingFace Hub; requires the weights to be cached already.
FITR_CLIP_LOCAL_FILES_ONLY=0
# Entries in the in-process (L1) embedding cache.
FITR_EMBED_CACHE_SIZE=512

# ----------------------------------------------------------------- Gemini ----
# The SDK itself reads GOOGLE_API_KEY / GEMINI_API_KEY (GOOGLE_API_KEY wins if
# both are set). We pass it explicitly so behaviour is not ambient, and mirror
# that same precedence. Set only one of these.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# gemini-2.0-flash and all gemini-1.5-* models are retired; do not use them.
# The Swift app names gemini-3.7-flash and gemini-3.1-pro on its own.
FITR_GEMINI_MODEL=gemini-3.6-flash
FITR_GEMINI_TEMPERATURE=0.7
FITR_GEMINI_TIMEOUT_S=30

# ---------------------------------------------------------------- weather ----
OPENWEATHERMAP_API_KEY=
FITR_WEATHER_TTL_SECONDS=3600
FITR_WEATHER_UNITS=imperial

# ------------------------------------------------------------------- auth ----
# header   trusts the X-User-Id request header (development only)
# firebase verifies a Firebase ID token from `Authorization: Bearer <token>`
FITR_AUTH_MODE=header
FITR_FIREBASE_PROJECT_ID=

# ------------------------------------------------------------------- misc ----
FITR_MAX_IMAGE_BYTES=10485760
FITR_CANDIDATE_K=12
# Comma-separated browser origins allowed to call the API, e.g.
# https://admin.example.com,http://localhost:5173. Empty sends no CORS headers,
# which is fine for the iOS app; it is not a browser.
FITR_CORS_ORIGINS=
# Root log level, passed to logging.basicConfig at startup.
FITR_LOG_LEVEL=INFO
